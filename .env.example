# Flask and browser transport
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT_MS=45000

# Credential-free defaults. Switch all three values for connected mode.
LLM_PROVIDER=demo
SEARCH_PROVIDER=demo
NEWS_PROVIDER=demo

# Primary connected generation (never commit a populated key)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT=35
GROQ_MAX_RETRIES=1
GROQ_MAX_TOKENS=1800

# Optional secondary provider. Select explicitly with LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_PROVIDER_SORT=latency
# Optional OpenRouter routing policy.
OPENROUTER_DATA_COLLECTION=
OPENROUTER_TIMEOUT=35
OPENROUTER_MAX_RETRIES=1
OPENROUTER_MAX_TOKENS=1800

# Connected retrieval and news
SEARCH_RESULTS_PER_SOURCE=2
SEARCH_FETCH_PER_SOURCE=1
SEARCH_MAX_WORKERS=4
SEARCH_TIMEOUT=8
DDGS_TEXT_BACKENDS=brave,bing,duckduckgo
DDGS_NEWS_BACKENDS=bing,yahoo,duckduckgo
PAGE_FETCH_TIMEOUT=8
PAGE_MAX_BYTES=1000000
PAGE_REDIRECT_LIMIT=3
EVIDENCE_CHARS_PER_SOURCE=3500
EVIDENCE_TOTAL_CHARS=12000
RETRIEVAL_CACHE_TTL_SECONDS=900
NEWS_RESULTS_LIMIT=30
EXTERNAL_USER_AGENT=MediVita/1.0 (+https://github.com/medivita)
